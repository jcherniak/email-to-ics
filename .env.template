POSTMARK_API_KEY="uuid"

FROM_EMAIL=""

INBOUND_CONFIRMED_EMAIL="confirmed@example.com"

TO_TENTATIVE_EMAIL="tentative@example.com"
TO_CONFIRMED_EMAIL="confirmed@example.com"
ERROR_EMAIL="errors@example.com"

GOOGLE_MAPS_API_KEY="AIza..."
MAPBOX_API_KEY="pk..."
GEOCODER_ORDER=mapbox,google
GEOCODE_COMBINE_MODEL=~anthropic/claude-haiku-latest
GEOCODE_DEFAULT_COUNTRY=US
# Set to mapbox, google, or all/1 to make live geocoder integration tests fail instead of skip when keys are missing or unauthorized.
# Command-line/process environment values take precedence over this .env value.
TESTS_REQUIRE_GEOCODER_INTEGRATION=0

HTTP_AUTH_USERNAME="user"
HTTP_AUTH_PASSWORD="pass"

ALLOWED_MODELS=~openai/gpt-latest,~google/gemini-pro-latest,~anthropic/claude-opus-latest,~anthropic/claude-sonnet-latest,~openai/gpt-mini-latest,~google/gemini-flash-latest,~moonshotai/kimi-latest
DEFAULT_MODEL=~openai/gpt-latest
URL_DETECTION_MODEL="~google/gemini-flash-latest"
URL_DETECTION_FALLBACK_MODEL="~openai/gpt-mini-latest"
ALTERNATE_MODEL="~google/gemini-pro-latest"

OPENROUTER_KEY="sk-or-xxxxxxxxx"

# URL fetch chain: direct -> firecrawl -> tinyfish_fetch -> tinyfish_browser.
# Levels whose key is empty are skipped.
FIRECRAWL_API_KEY=""
TINYFISH_API_KEY=""
FETCH_DIRECT_TIMEOUT=30
FETCH_FIRECRAWL_TIMEOUT=60
FETCH_FIRECRAWL_WAIT_MS=3000
FETCH_TINYFISH_FETCH_TIMEOUT=90
FETCH_TINYFISH_BROWSER_TIMEOUT=180
# lite or stealth (stealth adds anti-bot handling; this level only runs after cheaper levels failed)
FETCH_TINYFISH_BROWSER_PROFILE=stealth

# Model-driven fetch: the model fetches URL inputs itself through function tools in this order:
# fetch_direct -> fetch_with_firecrawl -> fetch_with_tinyfish -> render_with_tinyfish_browser (keyless levels omitted).
MAX_TOOL_CALLS=8
MAX_TOOL_CALLS_PER_TOOL=3
TOOL_CONTENT_MAX_CHARS=150000

# Readability content cleanup for HTML supplied with the request (extension capture, CLI --html, email bodies).
# Requires node + @mozilla/readability + jsdom (`npm install` at the project root); failures fall back to the lightened full page.
READABILITY_ENABLED=1
READABILITY_NODE_BINARY=node
READABILITY_TIMEOUT=20
READABILITY_MIN_TEXT_LENGTH=200

# Generation retry flow: per model, Readability snippet then full page on the first fetch level with content,
# full page on later levels, then the next model (DEFAULT_MODEL, ALTERNATE_MODEL, remaining ALLOWED_MODELS).
MAX_GENERATION_ATTEMPTS=24
GENERATION_TIME_BUDGET_SECONDS=600

# Public URL of index.php, used for the links in "choose events" emails (e.g. https://example.com/email-to-ics/).
PUBLIC_BASE_URL=""
# Server-side candidate/edit state: directory (default <project>/candidates), retention, size cap.
CANDIDATES_DIR=""
CANDIDATE_TTL_DAYS=30
MAX_CANDIDATES_DIR_SIZE=50M
# Reply-to-edit: Postmark inbound catch-all subdomain. Every calendar email gets Reply-To edit-<key>@<domain>;
# replying with instructions regenerates the event(s). Leave empty to disable the Reply-To header.
INBOUND_REPLY_DOMAIN=""
MAX_EDIT_ROUNDS=10
# 1 = every email link opens a one-button confirm page (safe against mail scanners that prefetch links); 0 = GET sends immediately.
CANDIDATE_LINKS_REQUIRE_CONFIRM=1

LOG_LEVEL=info

# Maximum number of times to process the same email (based on MessageID)
MAX_EMAIL_RETRIES=1
